Algoritmo sumadenumeros
	//EN LAS LINEAS QUE VIENE NO DEFINO VARIABLE
	definir numero1,numero2,suma,restar,divide Como entero;
	escribir"ingresa tu primer numero";
	leer numero1;
	Escribir "ingresa tu segundo numero"
	leer numero2;
	//Ahora vamos a realizar la suma de los numeros 
	suma<-numero1+numero2;
	restar<-numero1-numero2;
	divide<-numero1/numero2;
	Escribir "resultado1:" suma;
	Escribir "resultado2:" restar;
	Escribir "resultado3:" divide;
FinAlgoritmo